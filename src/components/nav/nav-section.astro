---
import { ExternalLink } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import NavMobile from "@/components/nav/nav-mobile";

const links = [
  { path: "/#hero", label: "Inicio" },
  { path: "/#services", label: "Servicios" },
  { path: "/#gallery", label: "Colección" },
  { path: "/#contact", label: "Nosotros" },
];
---

<header
  id="header"
  class="w-full py-3 fixed top-0 z-50 bg-transparent transition-all duration-300"
>
  <div class="max-w-6xl px-4 lg:px-0 mx-auto flex justify-between">
    <a
      href="/"
      class={buttonVariants({
        variant: "ghost",
        class: "font-heading text-xl font-bold",
      })}>Áurea</a
    >
    <nav class="hidden md:block">
      {
        links.map((link) => (
          <a href={link.path} class={buttonVariants({ variant: "ghost" })}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="hidden md:block">
      <a href="/#contact" class={buttonVariants()}>Nosotros <ExternalLink /></a>
    </div>
    <div class="md:hidden">
      <NavMobile links={links} client:load />
    </div>
  </div>
</header>

<script>
  const navbar = document.querySelector("#header");

  function handleScroll() {
    if (!navbar) return;

    const isScrolled = window.scrollY > 50;

    navbar.classList.toggle("bg-transparent", !isScrolled);
    navbar.classList.toggle("bg-muted-foreground/90", isScrolled);
    navbar.classList.toggle("text-muted", isScrolled);
    navbar.classList.toggle("shadow-md", isScrolled);
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll;
</script>
